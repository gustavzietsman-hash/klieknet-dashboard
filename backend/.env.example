# Microsoft Azure AD App Registration (client credentials / app-only)
MICROSOFT_CLIENT_ID=your-application-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret-value
MICROSOFT_TENANT_ID=your-tenant-id

# UPN or object ID of the mailbox to read (e.g. gustav@klieknet.com)
MICROSOFT_USER_ID=user@yourdomain.com

# Frontend origin (used for CORS)
FRONTEND_URL=http://localhost:3001

# Server
PORT=3000
APP_URL=http://localhost:3000

# AWS SES — email sending
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_SES_REGION=af-south-1
EMAIL_TEMPLATE_PATH=/absolute/path/to/email-template-aws.html
